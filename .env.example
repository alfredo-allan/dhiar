# ---------------------------------------------------------------------------
# Front-end (Next.js) - copie para .env.local em dev; na Vercel, cadastre em
# Project Settings -> Environment Variables (Production e Preview).
# Variáveis NEXT_PUBLIC_* vão para o navegador: nunca coloque segredo nelas.
# ---------------------------------------------------------------------------

# Segredo do cookie de sessão que protege /admin (src/lib/session.ts).
# Gere com: openssl rand -base64 32   (OBRIGATÓRIO em produção)
SESSION_SECRET=

# API Flask. Em produção, use um subdomínio da própria loja
# (ex.: https://api.sualoja.com.br/api/v1) para o cookie de sessão ser
# "same-site" e não depender de cookie de terceiros.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Identidade da loja (troca a marca sem mexer em código) ---------------
NEXT_PUBLIC_STORE_NAME=DHIAR Perfumes
NEXT_PUBLIC_STORE_SLUG=dhiar
NEXT_PUBLIC_STORE_TAGLINE=Sinta a essência. Perfumes originais das grandes casas, com entrega para todo o Brasil.
NEXT_PUBLIC_STORE_CONTACT_EMAIL=contato@dhiar.com.br
NEXT_PUBLIC_STORE_LEGAL_NAME=
NEXT_PUBLIC_STORE_CNPJ=
# Logos (deixe vazio para usar o nome em texto). Arquivos em public/branding/.
NEXT_PUBLIC_STORE_LOGO_LIGHT_BG=
NEXT_PUBLIC_STORE_LOGO_DARK_BG=
NEXT_PUBLIC_STORE_INSTAGRAM=
NEXT_PUBLIC_STORE_TIKTOK=
NEXT_PUBLIC_STORE_PINTEREST=
NEXT_PUBLIC_STORE_WHATSAPP=

# --- LGPD / marketing ------------------------------------------------------
# Mudar a versão faz o banner de cookies aparecer de novo para todos.
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-11
# Meta Pixel: só carrega depois do consentimento de marketing.
NEXT_PUBLIC_META_PIXEL_ID=
